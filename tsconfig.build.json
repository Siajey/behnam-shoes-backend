{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "./src"
      ],
      "@api/*": [
        "./src/api/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@otp/*": [
        "./src/otp/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "dev-scripts",
    "**/*spec.ts"
  ],
  "include": [
    "test/**/*",
    "src/**/*",
    "global.d.ts"
  ]
}
