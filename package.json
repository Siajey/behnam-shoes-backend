{
  "name": "behnam-shoes-backend",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "_moduleAliases": {
    "@api": "dist/src/api",
    "@common": "dist/src/common",
    "@otp": "dist/src/otp"
  },
  "scripts": {
    "build": "NODE_ENV=production nest build",
    "start": "NODE_ENV=production nest start",
    "start:prod": "NODE_ENV=production node dist/main",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config test/e2e/jest-e2e.ts",
    "test:watch": "jest --config test/e2e/jest-e2e.ts --watch",
    "test:cov": "jest --config test/e2e/jest-e2e.ts --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/e2e/jest-e2e.ts --detectOpenHandles --runInBand",
    "test:unit": "jest --config test/unit/jest-unit.ts --detectOpenHandles",
    "migrate:prod": "NODE_ENV=production npx drizzle-kit migrate",
    "migrate:dev": "NODE_ENV=development npx drizzle-kit migrate",
    "migration-generate": "npx drizzle-kit generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siajey/behnam-shoes-backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Siajey/behnam-shoes-backend/issues"
  },
  "homepage": "https://github.com/Siajey/behnam-shoes-backend#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/secure-session": "^8.4.1",
    "@keyv/redis": "^6.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "pino-pretty": "^13.2.0",
    "postgres": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^12.3.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "find-my-way": ">=9.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
